---
type Name = 'github' | 'linkedin' | 'mail' | 'arrow' | 'sun' | 'moon';

interface Props {
  name: Name;
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Name, string> = {
  github:
    'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z',
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.64h.05a4.17 4.17 0 0 1 3.75-2.06c4.01 0 4.75 2.64 4.75 6.07V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21h-4V9Z',
  mail: 'M3 5.5h18a1 1 0 0 1 1 1V17.5a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1Zm1.6 2L12 12.7l7.4-5.2H4.6Z',
  arrow: 'M5 12h12.2l-4.6-4.6L14 6l7 6-7 6-1.4-1.4 4.6-4.6H5v-2Z',
  sun: 'M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-13.5V1m0 22v-2.5M20.5 12H23M1 12h2.5m14.3-6.3 1.8-1.8M4.4 19.6l1.8-1.8m11.6 0 1.8 1.8M4.4 4.4l1.8 1.8',
  moon: 'M20 14.2A8.5 8.5 0 0 1 9.8 4a8.5 8.5 0 1 0 10.2 10.2Z',
};

const stroked = name === 'sun';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill={stroked ? 'none' : 'currentColor'}
  stroke={stroked ? 'currentColor' : undefined}
  stroke-width={stroked ? 1.7 : undefined}
  stroke-linecap={stroked ? 'round' : undefined}
>
  <path d={paths[name]}></path>
</svg>
